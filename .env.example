# ── Servidor ─────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# Direcciones que pueden llamar a esta API (separadas por coma)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# URL del sitio público (se usa en los enlaces de los correos)
FRONTEND_URL=http://localhost:3000

# ── Base de datos MySQL (Clever Cloud u otra) ────────────
DATABASE_URL=mysql://usuario:contraseña@host:3306/family_love
# true si tu proveedor exige SSL (Clever Cloud normalmente sí)
DB_SSL=false

# ── Seguridad ────────────────────────────────────────────
# Genera uno largo y aleatorio: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=7d

# ── Google (el mismo Client ID que usan frontend y admin) ─
GOOGLE_CLIENT_ID=

# ── Correo (Resend) ──────────────────────────────────────
RESEND_API_KEY=
MAIL_FROM=Family Love <onboarding@resend.dev>
CONTACT_EMAIL=familylovevoluntariado@gmail.com

# ── Cloudinary ───────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
